# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Auth
JWT_SECRET=your_long_random_jwt_secret

# Server
PORT=4000
NODE_ENV=development

# CORS (comma-separated origins for production)
# For production, set CORS_ORIGINS with your frontend domain
# Example: https://e-commerce-frontend-nine-snowy.vercel.app,https://your-other-domain.com
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=https://e-commerce-frontend-nine-snowy.vercel.app,http://localhost:3000,http://localhost:5173

# Shipping
FREE_SHIPPING_THRESHOLD=50
STANDARD_SHIPPING_COST=5.99
LOW_STOCK_THRESHOLD=5

